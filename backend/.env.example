# Copy to .env and fill in real values. Never commit .env.
#
# Every variable the backend reads is listed here. Production values live on
# Render → willkemedge-dashboard → Environment. To mirror production locally,
# paste that page into backend/.env.live (git-ignored), one KEY=value per line,
# then run copy-live-db.ps1 — it rebuilds .env from those values and forces
# messaging, hosts and the database back to local-safe settings.

# Django core
DJANGO_SECRET_KEY=replace-me-with-a-long-random-50-char-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (leave blank to use SQLite in dev)
DATABASE_URL=

# Redis (Celery broker + result backend)
REDIS_URL=redis://localhost:6379/0
# Run background tasks inline in the request instead of on a worker. Production
# has no worker, so this is true there (and always true in development).
CELERY_TASK_ALWAYS_EAGER=True

# Extra origins allowed for connect-src in the Content-Security-Policy header.
# Blank in production (the frontend is on Vercel and calls the API cross-origin
# via CORS, not CSP). Dev defaults to http://localhost:8000.
CSP_CONNECT_SRC=

# CORS — set to your Vercel frontend URL in production
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Client IP for the login lockout and audit. Render appends to X-Forwarded-For,
# so its leftmost entry is spoofable. After deploy, sign in as the owner and
# open /api/auth/client-ip/ to see what the proxies send, then set ONE of:
#   CLIENT_IP_HEADER=HTTP_CF_CONNECTING_IP   (a header the proxy overwrites)
#   TRUSTED_PROXY_HOPS=1                     (entries appended from the right)
# Both blank = the old leftmost behaviour.
CLIENT_IP_HEADER=
TRUSTED_PROXY_HOPS=

# Frontend URL — used in password reset emails
FRONTEND_URL=http://localhost:5173

# ── Co-operative Bank IPN (Instant Payment Notification) ───────────────────
# Bearer token Co-op presents on each IPN POST. Generate a strong random value
# (python -c "import secrets; print(secrets.token_urlsafe(48))") and share it
# with the bank. Keep it secret; rotate if leaked.
COOP_IPN_TOKEN=
# The Co-op account behind Paybill 400222 — credits to any other AcctNo are ignored.
COOP_ACCOUNT_NUMBER=01136069098300
# Comma-separated source IPs/CIDRs Co-op posts from (defence-in-depth). Requests
# from outside this list get 403. Single IPs or CIDR (e.g. 196.201.214.0/24).
# Leave blank to allow all until Co-op shares their range — see
# docs/coop-ipn-security.md.
COOP_IPN_ALLOWED_IPS=
# Trusted proxies in front of the endpoint (Render edge = 1). Used to read the
# real client IP from X-Forwarded-For for the allowlist. 0 = no proxy.
COOP_IPN_TRUSTED_PROXY_COUNT=1
# Dev only: set true (with DEBUG) to skip bearer auth locally.
ALLOW_INSECURE_COOP_IPN=
# Master switch for AUTOMATIC tenant messaging — payment receipts, rent
# reminders and arrears reminders: everything the system sends on its own.
# Set to false to run against live data without messaging tenants
# (verification, dry runs, handover). Blank or true = normal sending.
#
# NOT affected, by design:
#   * the admin broadcast form — a person clicks send, knows they did, and
#     sees the result, so it stays usable while automatic messaging is paused
#   * admin/director alerts below — unmatched credits, reversals and the daily
#     summary keep arriving, which is how you verify the figures are right
#     before switching this back on
#
# Suppressed reminders are saved as PENDING with an explanatory note rather
# than dropped, so nothing is lost while it is off.
TENANT_NOTIFICATIONS_ENABLED=
# Master switch for INTERNAL staff alerts — unmatched credits, the daily
# reconciliation summary, and reversal authorisation requests. Set to false for
# a fully quiet testing window. Blank or true = normal sending.
#
# Caution: this also silences the reversal request. The reversal is still never
# auto-applied, but nobody is told one is waiting, so switch this back on
# before the system runs unattended. Suppressed reversals are logged at WARNING.
ADMIN_ALERTS_ENABLED=
# Admin alerted (SMS + email) when a credit can't be auto-matched / errors.
ADMIN_ALERT_PHONE=
ADMIN_ALERT_EMAIL=
# Authorising director (Dr. Osoro) — alerted to authorize bank reversals.
# Falls back to ADMIN_ALERT_* if blank.
DIRECTOR_ALERT_PHONE=
DIRECTOR_ALERT_EMAIL=
# Director's *login* email — only this user may click "Authorize reversal" in
# admin. Leave blank to fall back to any superuser.
DIRECTOR_EMAIL=
# Token a free cron service (cron-job.org / GitHub Actions / UptimeRobot)
# presents to fire the scheduled jobs at /api/payments/cron/<job>/. This is what
# stands in for Celery beat, so no paid Render worker/beat/Redis is needed.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
CRON_TRIGGER_TOKEN=
# Older reconciliation-only name. Still accepted; prefer CRON_TRIGGER_TOKEN.
RECONCILIATION_TRIGGER_TOKEN=

# Bill-ref prefix: tenants pay "<prefix>#<house number>" (e.g. "90290#A12").
MPESA_ACCOUNT_PREFIX=90290

# ── Africa's Talking (SMS) ─────────────────────────────────────────────────
# Master kill switch for every outbound SMS. Off unless set to true.
SMS_ENABLED=
# Master kill switch for every email to a tenant. Off unless set to true.
TENANT_EMAIL_ENABLED=
AT_API_KEY=
AT_USERNAME=sandbox
# Approved alphanumeric sender ID, registered with Safaricom under the
# TRANSACTIONAL category. Case-sensitive and passed to AT verbatim — it must
# read exactly WILKEM_EDGE. Leave blank until AT confirms approval; a wrong or
# unapproved value is rejected as InvalidSenderId.
# Transactional registration carries a KES 25,000 penalty if this sender ID is
# ever used for promotional/marketing content — receipts, rent reminders and
# arrears notices only. Never use it for the admin broadcast form.
AT_SENDER_ID=
# SMS wallet card on Settings (read-only balance + M-Pesa top-up details).
# Cost of one SMS page, used to estimate "messages left" from the balance.
# KES 1.60 is the rate this account actually pays for WILKEM_EDGE sends.
AT_SMS_UNIT_COST=1.60
# Below this balance the dashboard shows a "running low" warning.
AT_BALANCE_LOW_THRESHOLD=500
# Africa's Talking M-Pesa top-up details, exactly as printed on
# Billing → Top Up in the AT console. These are shown to the director as
# "pay here"; re-check them against the console if the AT account ever changes.
AT_TOPUP_PAYBILL=525900
AT_TOPUP_ACCOUNT=wilkemedge
# Days before a tenant's rent due day to fire the reminder SMS (default 3).
RENT_REMINDER_LEAD_DAYS=3
# The monthly statement run also texts each tenant a summary. Set false to keep
# the statement emails but skip those SMS (e.g. when the AT wallet is empty).
STATEMENT_SMS_ENABLED=True

# ── Billing calendar ──────────────────────────────────────────────────────
# Day of the month next month's invoice is generated: commercial on
# STATEMENT_RUN_DAY, residential on RESIDENTIAL_RUN_DAY. Clamped to 1..28.
# Changes what the jobs compute, not when the external scheduler fires them.
STATEMENT_RUN_DAY=25
RESIDENTIAL_RUN_DAY=28

# ── Email (SMTP — Gmail) ───────────────────────────────────────────────────
# Generate an App Password at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification on the Google account first).
# The 16-char password goes in EMAIL_HOST_PASSWORD with no spaces.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=wilkem.ventures@gmail.com
EMAIL_HOST_PASSWORD=
# Display name + address tenants will see
DEFAULT_FROM_EMAIL=Wilkem Ventures <wilkem.ventures@gmail.com>

# ── Sentry (error monitoring — production only) ────────────────────────────
# Leave blank to disable. Get the DSN from Sentry → Project → Client Keys (DSN).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Optional release identifier (e.g. git SHA) for grouping errors by deploy.
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── One-off: first admin account (python manage.py create_initial_admin) ──
# Set only for the deploy that creates the account, then delete all three.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
